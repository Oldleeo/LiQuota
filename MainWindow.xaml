<Window x:Class="CodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiQuota" Icon="Assets/LiQuota.ico" Width="82" Height="22"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="BadgeBorder" Background="{DynamicResource BadgeBackground}"
                BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="6"
                Cursor="Hand" ToolTip="{Binding BadgeToolTip}"
                MouseLeftButtonUp="Badge_MouseLeftButtonUp" MouseRightButtonUp="Badge_MouseRightButtonUp">
            <Grid Margin="7,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="5" Height="5" Fill="{Binding BadgeBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding BadgeText}" Foreground="{DynamicResource BadgeText}"
                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Grid.Column="2" Data="M 0 0 L 2.5 2.5 L 5 0" Stroke="{DynamicResource Chevron}"
                      StrokeThickness="1.1" Width="5" Height="2.5" Stretch="Fill" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Popup x:Name="QuotaPopup" PlacementTarget="{Binding ElementName=BadgeBorder}" Placement="Bottom"
               HorizontalOffset="-218" VerticalOffset="7" AllowsTransparency="True"
               StaysOpen="False" PopupAnimation="Fade">
            <Border Width="300" Padding="14" Background="{DynamicResource PopupBackground}"
                    BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.20" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="1,0,1,10">
                        <StackPanel>
                            <TextBlock Text="LiQuota" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextTertiary}" FontSize="10.5"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="↻" ToolTip="立即刷新" Style="{StaticResource MiniButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshButton_Click"/>
                    </Grid>

                    <Border Margin="0,0,0,9" Padding="10,7" Background="{DynamicResource CardBackground}" CornerRadius="8">
                        <TextBlock Text="{Binding AccountText}" Foreground="{DynamicResource TextSecondary}"
                                   FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding QuotaWindows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="11,9"
                                            Background="{DynamicResource CardBackground}" CornerRadius="9">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}" FontSize="10.5"/>
                                                <TextBlock Text="{Binding RemainingPercentText}" Foreground="{Binding AccentBrush}"
                                                           HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Height="3" Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding RemainingWidth, Mode=OneWay}"/>
                                                    <ColumnDefinition Width="{Binding UsedWidth, Mode=OneWay}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding AccentBrush}" CornerRadius="2,0,0,2"/>
                                                <Border Grid.Column="1" Background="{DynamicResource PopupBorder}" CornerRadius="0,2,2,0"/>
                                            </Grid>
                                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding ResetText}" Foreground="{DynamicResource TextTertiary}" FontSize="9.5"/>
                                                <TextBlock Text="{Binding UsedText}" Foreground="{DynamicResource TextTertiary}"
                                                           FontSize="9.5" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Padding="10,7" Margin="0,1,0,7" Background="{DynamicResource ErrorBackground}"
                            CornerRadius="8" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ErrorText}"
                                   FontSize="10" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Margin="1,1,1,0" Text="{Binding FooterText}" Foreground="{DynamicResource TextTertiary}"
                               FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
